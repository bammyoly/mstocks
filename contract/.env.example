# =
# mstocks — deploy configuration
# =

# 24-word mnemonic (or 64-hex-character seed) of the deploying wallet.
WALLET_SEED=

# Target network: 'preview' (default), 'preprod' or 'undeployed' (local devnet).
NETWORK=

# Endpoints (defaults for each network are built in; uncomment to override).
# MN_NODE_URL=
# MN_INDEXER_URL=
# MN_INDEXER_WS=
# MN_PROOF_SERVER_URL=

# Password protecting the local private-state/signing-key stores.
# Must be at least 16 characters and use at least 3 character classes.
PRIVATE_STATE_PASSWORD=

# Where deploy.ts exports deployment artifacts (relative to contract/).
FRONTEND_EXPORT_DIR=

